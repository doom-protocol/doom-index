{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "doom-index",
  "main": "src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2025-03-25",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env",
    "global_fetch_strictly_public",
    "enable_weak_ref",
  ],
  "triggers": {
    "crons": ["0 * * * *"],
  },
  "routes": [
    {
      "pattern": "doomindex.fun",
      "custom_domain": true,
    },
  ],
  "vars": {
    "NODE_ENV": "production",
    "LOG_LEVEL": "INFO",
    "NEXT_PUBLIC_BASE_URL": "https://doomindex.fun",
    "IMAGE_MODEL": "runware:400@1",
    "NEXT_PUBLIC_GENERATION_INTERVAL_MS": "3600000",
    "ARWEAVE_GATEWAY_BASE_URL": "https://permagate.io",
  },
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "doom-index-next-inc-cache",
      "preview_bucket_name": "doom-index-next-inc-cache",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doom-index",
      "database_id": "f953738f-09c7-47bd-8235-2affa996db8e",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "VIEWER_KV",
      "id": "8c588d03a8ab4cd19e0c458dcabf1bec",
    },
  ],
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "images": {
    "binding": "IMAGES",
  },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "env": {
    "dev": {
      "triggers": {
        "crons": ["*/10 * * * *"],
      },
      "vars": {
        "NODE_ENV": "development",
        "LOG_LEVEL": "DEBUG",
        "NEXT_PUBLIC_BASE_URL": "http://localhost:8787",
        "IMAGE_MODEL": "runware:400@1",
        "NEXT_PUBLIC_GENERATION_INTERVAL_MS": "600000",
        "ARWEAVE_GATEWAY_BASE_URL": "https://permagate.io",
      },
      "r2_buckets": [
        {
          "binding": "NEXT_INC_CACHE_R2_BUCKET",
          "bucket_name": "doom-index-next-inc-cache",
          "preview_bucket_name": "doom-index-next-inc-cache",
        },
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "doom-index",
          "database_id": "f953738f-09c7-47bd-8235-2affa996db8e",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "VIEWER_KV",
          "id": "8c588d03a8ab4cd19e0c458dcabf1bec",
        },
      ],
      "ai": {
        "binding": "AI",
        "remote": true,
      },
      "images": {
        "binding": "IMAGES",
      },
      "assets": {
        "directory": "./dist/client",
        "binding": "ASSETS",
      },
    },
  },
}
