{
  "name": "doom-index",
  "version": "2.0.0",
  "private": false,
  "type": "module",
  "description": "A decentralized archive of financial emotions. AI generates one painting every minute, translating the collective psychology of 8 pump.fun tokens into visual art.",
  "scripts": {
    "dev": "bunx vinext dev --port 8787",
    "build": "vinext build",
    "build:cf": "bun run build",
    "start": "bunx vinext start --port 8787",
    "lint": "eslint . --cache --cache-location .cache/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-location .cache/eslint/.eslintcache --cache-strategy content",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsgo --noEmit --incremental --tsBuildInfoFile .cache/tsgo/typecheck.tsbuildinfo",
    "test": "bun test --env-file=.env.example --preload=./tests/preload.ts",
    "test:unit": "bun test --env-file=.env.example --grep 'unit' --preload=./tests/preload.ts",
    "test:integration": "bun test --env-file=.env.example --grep 'integration' --preload=./tests/preload.ts",
    "cf-typegen": "wrangler types --config wrangler.jsonc --env-interface CloudflareEnv src/types/cloudflare-env.d.ts",
    "generate:img": "bun --env-file=.env.local scripts/gen-img.ts",
    "generate:framed-glb": "bun scripts/generate-framed-glb.ts",
    "watch-cron": "bun scripts/watch-cron.ts",
    "truncate-r2": "bun --env-file=.env.local scripts/truncate-r2.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun --env-file=.env.local drizzle-kit migrate",
    "db:migrate:prod": "bun --env-file=.env.production drizzle-kit migrate",
    "db:push": "bun --env-file=.env.local drizzle-kit push",
    "db:push:prod": "bun --env-file=.env.production drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:prod": "bun --env-file=.env.production drizzle-kit studio",
    "knip": "knip"
  },
  "dependencies": {
    "@ardrive/turbo-sdk": "^1.41.0",
    "@coingecko/coingecko-typescript": "^2.5.0",
    "@mdx-js/react": "^3.1.1",
    "@next/third-parties": "^16.1.6",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/web3.js": "^1.98.4",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@tanstack/react-query": "^5.90.21",
    "@tavily/core": "^0.5.14",
    "@trpc/client": "^11.12.0",
    "@trpc/react-query": "^11.12.0",
    "@trpc/server": "^11.12.0",
    "@trpc/tanstack-react-query": "^11.12.0",
    "drizzle-orm": "^0.44.7",
    "neverthrow": "^7.2.0",
    "next": "^16.1.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "three": "^0.181.2",
    "three-stdlib": "^2.36.1",
    "use-haptic": "^1.1.13",
    "use-sound": "^5.0.0",
    "valibot": "^1.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.28.0",
    "@cloudflare/workers-types": "^4.20260313.1",
    "@happy-dom/global-registrator": "^20.8.4",
    "@mdx-js/rollup": "^3.1.1",
    "@next/eslint-plugin-next": "^16.1.6",
    "@next/mdx": "16.1.6",
    "@posaune0423/eslint-config": "^1.3.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@typescript/native-preview": "^7.0.0-dev.20260314.1",
    "@vitejs/plugin-rsc": "^0.5.21",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.8",
    "better-sqlite3": "^12.8.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.39.4",
    "knip": "^5.86.0",
    "lefthook": "^2.1.4",
    "leva": "^0.10.1",
    "oxfmt": "^0.40.0",
    "react-server-dom-webpack": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "vinext": "^0.0.30",
    "vite": "^8.0.0",
    "wrangler": "^4.73.0"
  },
  "engines": {
    "node": ">=24.11.1"
  },
  "packageManager": "bun@1.3.10"
}
